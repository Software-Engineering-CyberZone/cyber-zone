@using MVC.Models
@model List<SessionItemViewModel>

@{
    ViewData["Title"] = "Мої Сесії";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Gemunu+Libre:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sessions.css" asp-append-version="true" />
}

<div class="sessions-page-container">
    <h2 class="sessions-page-title">Сесії</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="review-success-msg">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="review-error-msg">@TempData["Error"]</div>
    }

    <div class="sessions-list">
        @foreach (var session in Model)
        {
            if (session.SessionState == "Active")
            {
                <div class="session-card expanded-session">
                    <div class="s-top-info expanded-top">
                        <div class="s-col-info">
                            <div class="s-club-name">@session.ClubName</div>
                            <div class="s-time-row">
                                <span>@session.Date</span>
                                <span>@session.Duration</span>
                                <span>@session.Time</span>
                            </div>
                        </div>

                        <div class="s-col-address">
                            <svg class="location-icon" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                            </svg>
                            @session.Address
                        </div>

                        <div class="s-col-pc">@session.PcNumber</div>

                        <div class="s-col-actions">
                            <div class="status-badge-started">Зараз Відвідує</div>
                        </div>
                    </div>

                    <div class="s-expanded-body">
                        <div class="s-timer-large js-session-timer" 
                             data-start-time="@session.SortDate.ToString("O")"
                             data-target-time="@session.TargetTime">
                            00:00:00
                        </div>
                        
                        <div class="s-expanded-actions">
                            <form asp-action="EndSession" method="post" style="margin: 0;">
                                <input type="hidden" name="id" value="@session.Id" />
                                <button type="submit" class="btn-s-gradient">Завершити</button>
                            </form>
                            <button class="btn-s-gradient">Додати</button>
                            <a asp-controller="Order" asp-action="Bar" class="btn-s-gradient" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">Відкрити Бар</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                var cardClass = session.SessionState == "Pending" ? "" : "inactive-session";
                
                <div class="session-card @cardClass">
                    <div class="s-col-info">
                        <div class="s-club-name">@session.ClubName</div>
                        <div class="s-time-row">
                            <span>@session.Date</span>
                            <span>@session.Duration</span>
                            <span>@session.Time</span>
                        </div>
                    </div>

                    <div class="s-col-address">
                        <svg class="location-icon" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                        </svg>
                        @session.Address
                    </div>

                    <div class="s-col-pc">@session.PcNumber</div>

                    <div class="s-col-actions">
                        @if (session.SessionState == "Pending")
                        {
                            <form asp-action="StartSession" method="post" style="margin: 0;">
                                <input type="hidden" name="id" value="@session.Id" />
                                <button type="submit" class="btn-s-start">Розпочати</button>
                            </form>
    
                            <form asp-action="CancelSession" method="post" style="margin: 0;">
                                <input type="hidden" name="id" value="@session.Id" />
                                <button type="submit" class="btn-s-cancel">Скасувати</button>
                            </form>
                        }
                        else
                        {
                            @if (session.HasReview)
                            {
                                <div class="status-badge-reviewed">Відгук Залишено</div>
                            }
                            else
                            {
                                <button type="button" class="btn-s-review" onclick="toggleReviewForm('@session.Id')">Залишити Відгук</button>
                            }
                        }
                    </div>

                    @if (!session.HasReview && session.SessionState == "Completed")
                    {
                        <div class="review-form-wrapper" id="review-form-@session.Id" style="display:none;">
                            <form asp-action="LeaveReview" method="post" class="review-inline-form">
                                <input type="hidden" name="ClubId" value="@session.ClubId" />
                                <div class="review-stars" id="stars-@session.Id">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="star-btn" data-value="@i" onclick="setRating('@session.Id', @i)">&#9733;</span>
                                    }
                                </div>
                                <input type="hidden" name="Rating" id="rating-@session.Id" value="0" />
                                <textarea name="Comment" class="review-textarea" maxlength="500" placeholder="Ваш коментар... (до 500 символів)"></textarea>
                                <div class="review-form-actions">
                                    <button type="submit" class="btn-s-review-submit">Відправити</button>
                                    <button type="button" class="btn-s-review-cancel" onclick="toggleReviewForm('@session.Id')">Скасувати</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/sessions.js" asp-append-version="true"></script>
}
