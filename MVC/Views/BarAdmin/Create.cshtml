@model CyberZone.Application.DTOs.CreateBarMenuItemDto
@{
    ViewData["Title"] = "Додати позицію в Меню";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-edit-create.css" asp-append-version="true" />
}

<div class="bar-container">
    <h2 style="margin-bottom: 25px;">@ViewData["Title"]</h2>

    <div class="cyber-panel">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" style="color: #E05BBE; margin-bottom: 15px;"></div>

            <input type="hidden" asp-for="ClubId" />

            <label asp-for="Name" class="form-label">Назва</label>
            <input asp-for="Name" class="cyber-input" placeholder="Наприклад: Кока-Кола 0.5" />
            <span asp-validation-for="Name" style="color: #E05BBE; font-size: 0.9em;"></span>

            <label asp-for="Category" class="form-label">Категорія</label>
            <select asp-for="Category" class="cyber-input" style="cursor: pointer;">
                <option value="Снеки">🍔 Снеки</option>
                <option value="Напої">🥤 Напої</option>
            </select>

            <label asp-for="Description" class="form-label">Опис (необов'язково)</label>
            <textarea asp-for="Description" class="cyber-input" rows="3" placeholder="Деталі позиції..."></textarea>

            <label asp-for="Price" class="form-label">Ціна (₴)</label>
            <input asp-for="Price" type="number" step="0.01" class="cyber-input" />
            <span asp-validation-for="Price" style="color: #E05BBE; font-size: 0.9em;"></span>

            <label asp-for="StockQuantity" class="form-label">Початковий залишок (шт)</label>
            <input asp-for="StockQuantity" type="number" class="cyber-input" value="0" />

            <div class="checkbox-container">
                <input asp-for="IsActive" class="cyber-checkbox" />
                <label asp-for="IsActive" style="color: #EDEDED; cursor: pointer;">Активно (показувати клієнтам)</label>
            </div>

            <button type="submit" class="cyber-btn-success">Створити позицію</button>
            <a asp-action="Index" class="cyber-btn-back">← Назад до Меню</a>
        </form>
    </div>
</div>
