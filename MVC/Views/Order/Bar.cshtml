@using MVC.Models
@model BarViewModel

@{
    ViewData["Title"] = "Бар клубу";
}

@section Styles {
    <link rel="stylesheet" href="~/css/bar.css" asp-append-version="true" />
}

<div class="bar-page-container">
    
    <div class="bar-header">
        <h2 class="bar-page-title">Меню бару</h2>
        <div class="cart-icon-wrapper" onclick="openCart()">
            <svg class="cart-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
            <span class="cart-dot" id="cartBadge" style="display: none;"></span>
        </div>
    </div>

    <div class="category-section">
        <div class="category-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 8l2 12h8l2-12M4 8h16M14 3l-2 5"/>
            </svg>
            Напої
        </div>
        <hr class="category-divider" />

        <div class="menu-grid">
            @foreach (var item in Model.Drinks)
            {
                <div class="menu-card">
                    <div class="menu-img-wrapper">
                        <img src="@item.ImageUrl" alt="@item.Name" class="menu-img" />
                    </div>
                    <div class="menu-info">
                        <div class="menu-name-row">
                            <span class="menu-name">@item.Name</span>
                            <span class="menu-desc">@item.Description</span>
                        </div>
                        <div class="menu-price">@item.Price.ToString("N0") грн</div>
                        <button class="btn-add-cart" onclick="addToCart('@item.Id', '@item.Name', @item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">Додати у кошик</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="category-section" style="margin-top: 50px;">
        <div class="category-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 8l2 12h8l2-12M4 8h16M14 3l-2 5"/>
            </svg>
            Снеки
        </div>
        <hr class="category-divider" />

        <div class="menu-grid">
            @foreach (var item in Model.Snacks)
            {
                <div class="menu-card">
                    <div class="menu-img-wrapper">
                        <img src="@item.ImageUrl" alt="@item.Name" class="menu-img" />
                    </div>
                    <div class="menu-info">
                        <div class="menu-name-row">
                            <span class="menu-name">@item.Name</span>
                            <span class="menu-desc">@item.Description</span>
                        </div>
                        <div class="menu-price">@item.Price.ToString("N0") грн</div>
                        <button class="btn-add-cart" onclick="addToCart('@item.Id', '@item.Name', @item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">Додати у кошик</button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<div id="cartModal" class="cart-modal-overlay" style="display: none;">
    <div class="cart-modal new-design-modal">

        <div class="cart-modal-header-centered">
            <h3>Кошик</h3>
            <p class="cart-subtitle">будь ласка, перевірте своє замовлення перед підтвердженням</p>
        </div>

        <div class="cart-modal-body" id="cartItemsContainer">
        </div>

        <div class="cart-modal-footer">
            <div class="cart-total-row">
                <span class="cart-total-label">Разом</span>
                <div class="dotted-leader"></div>
                <span class="cart-total-sum"><span id="cartTotalSum">0</span> грн</span>
            </div>

            <p class="cart-warning">
                Увага!<br>
                Кошти за товар будуть списані з вашого внутрішнього гаманця.<br>
                Якщо ви хочете обрати інший спосіб оплати, пройдіть в бар, будь ласка
            </p>

            <div id="cartError" class="cart-error-message"></div>

            <div class="cart-actions-vertical">
                <button class="btn-order-gradient" onclick="checkout()" id="btnCheckout">Замовити</button>
                <button class="btn-cancel-outline" onclick="closeCart()">Скасувати</button>
            </div>
        </div>
    </div>
</div>

<div id="successModal" class="cart-modal-overlay" style="display: none; z-index: 1000;">
    <div class="cart-modal new-design-modal" style="text-align: center; max-width: 350px; padding: 40px 20px;">
        <div class="success-icon-wrapper">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <h3 style="margin-bottom: 10px;">Оплата успішна!</h3>
        <p id="successMessageText" style="color: #a0a0a0; margin-bottom: 30px; font-size: 14px;">
            Ваше замовлення прийнято в роботу.
        </p>
        <button class="btn-order-gradient" onclick="closeSuccessModal()">Чудово!</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/bar.js" asp-append-version="true"></script>
}